<?xml version="1.0" encoding="utf-8"?>
<!--
    GigHala standalone brand logo for use on the login screen and anywhere
    a self-contained, coloured icon is needed (as opposed to the adaptive-icon
    foreground that is placed on a separate background layer).

    Design: dark-green circle (#2E7D32) with white crescent moon (left) and
    white "GH" letters (right), all within a 108×108 viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Green circle background ────────────────────────────────────── -->
    <!-- Two semicircle arcs form a complete circle: centre (54,54) r=52  -->
    <path
        android:fillColor="#2E7D32"
        android:pathData="M2,54 A52,52 0 0 1 106,54 A52,52 0 0 1 2,54 Z" />

    <!-- ── Crescent moon ──────────────────────────────────────────────── -->
    <!-- Outer circle centre (32,54) r=21 ; inner circle centre (40,54) r=15.
         Intersection points ≈ (49.5, 42.4) and (49.5, 65.6).            -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M49.5,42.4
            A21,21 0 1 0 49.5,65.6
            A15,15 0 1 1 49.5,42.4 Z" />

    <!-- ── Letter G ───────────────────────────────────────────────────── -->
    <!-- bounds x=48..67, y=36..72                                        -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M67,42
            C65,37 61,36 58,36
            C50,36 48,43 48,54
            C48,65 50,72 58,72
            C63,72 67,68 67,63
            L67,53 L58,53 L58,59 L62,59 L62,64
            C61,67 59,68 58,68
            C53,68 53,61 53,54
            C53,47 53,40 58,40
            C61,40 64,41 66,45 Z" />

    <!-- ── Letter H ───────────────────────────────────────────────────── -->
    <!-- bounds x=70..86, y=36..72                                        -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M70,36 L70,72
            L74,72 L74,57
            L82,57 L82,72
            L86,72 L86,36
            L82,36 L82,51
            L74,51 L74,36 Z" />

</vector>
